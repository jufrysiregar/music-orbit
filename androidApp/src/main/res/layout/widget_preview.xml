<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the launcher's widget picker (android:previewLayout). Mirrors the real
  Glance widget (MusicWidget.provideGlance): a compact SINGLE-ROW mini-player — album art, title +
  artist, and prev / play / next on the right. Uses only RemoteViews-safe views (LinearLayout /
  ImageView / TextView) so the launcher can inflate it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="12dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_art_bg"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_stat_music"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_preview_artist"
            android:textColor="#FFB8B5C9"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_bg"
        android:padding="9dp"
        android:src="@drawable/ic_widget_prev"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button_bg"
        android:padding="11dp"
        android:src="@drawable/ic_widget_play"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button_bg"
        android:padding="9dp"
        android:src="@drawable/ic_widget_next"
        android:contentDescription="@null" />
</LinearLayout>
